{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "LS-Trainer",
	"version": "0.1.1",
	"identifier": "studio.lean.ls-trainer",
	"build": {
		"frontendDist": "../dist",
		"devUrl": "http://localhost:1420",
		"beforeDevCommand": "npm run dev",
		"beforeBuildCommand": "npm run build"
	},
	"app": {
		"windows": [
			{
				"title": "LS-Trainer",
				"width": 800,
				"height": 600,
				"resizable": true,
				"fullscreen": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"resources": {
			"../setup-venv.bat": "setup-venv.bat"
		},
		"windows": {
			"nsis": {
				"installerHooks": "installer-hooks.nsh"
			}
		},
		"android": {
			"debugApplicationIdSuffix": ".debug"
		}
	}
}
